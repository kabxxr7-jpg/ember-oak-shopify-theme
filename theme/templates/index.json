            "rating": 5,
            "product": "highland-decaf"
          }
        },
        "t4": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>The quiz sent me to Campfire for cold brew and it was spot on. Sweet, smooth and no bitterness at all.</p>",
            "author": "Diego R.",
            "location": "San Diego, CA",
            "rating": 5,
            "product": "campfire-cold-brew-blend"
          }
        },
        "t5": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Midnight Hearth pulls a thick, chocolatey shot on my home machine. Lovely in a flat white too.</p>",
            "author": "Sam T.",
            "location": "Brooklyn, NY",
            "rating": 4,
            "product": "midnight-hearth-espresso"
          }
        }
